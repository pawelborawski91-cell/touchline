{
  "name": "@touchline/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Skia rendering of read-only TOUCHLINE match snapshots, plus camera and coordinate transforms.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
